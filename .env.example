# Copy this file to .env and fill in real values. NEVER commit .env.
# Supabase project configuration (the publishable key and URL are public;
# the service role key and guest/encryption secrets must stay server-only).
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (NOT exposed to the browser; keep out of git)
SUPABASE_SERVICE_ROLE_KEY=
USTAD_GUEST_SECRET=
USTAD_KEY_ENCRYPTION_SECRET=
# Optional: any provider API keys / additional env used by the server

# Copy this file to .env and fill in real values. NEVER commit .env.
# Supabase project configuration (the publishable key and URL are public;
# the service role key and guest/encryption secrets must stay server-only).
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets (NOT exposed to the browser; keep out of git).
# Minimum 32 characters, no whitespace, no placeholders — validated at startup
# by src/lib/env-guard.ts. Generate with: openssl rand -hex 32
SUPABASE_SERVICE_ROLE_KEY=
USTAD_GUEST_SECRET=
USTAD_KEY_ENCRYPTION_SECRET=

# Rotation window only — set to the PREVIOUS value of the secret above while
# rotating, then delete. Keeps old guest tokens valid and old encrypted
# provider keys readable. See docs/SECRETS.md.
USTAD_GUEST_SECRET_PREVIOUS=
USTAD_KEY_ENCRYPTION_SECRET_PREVIOUS=

# Built-in USTAD Core (chat / image / voice fallback via Lovable AI gateway).
LOVABLE_API_KEY=
# Shared secret for the scheduled exam cron endpoint (and its rotation slot).
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=

# Event operators (Part 6). Comma/space-separated list of guest ids allowed to
# create, publish, cancel and finalize tournament events. Server-only: it is
# never sent to the browser. LEAVING THIS EMPTY DENIES EVERYONE, which is the
# safe default — set it only on the deployment where you run event operations.
# Example: USTAD_EVENT_ADMINS=guest_1a2b3c4d5e6f7890,guest_0987654321fedcba
USTAD_EVENT_ADMINS=
